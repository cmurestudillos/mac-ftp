{
  "name": "mac-ftp",
  "version": "1.2.0",
  "description": "Cliente FTP/FTPS de escritorio con doble panel, inspirado en Transmit",
  "homepage": "https://cmurestudillos.github.io/mac-ftp/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmurestudillos/mac-ftp.git"
  },
  "main": "main.js",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "start": "electron .",
    "lint": "eslint main.js preload.js renderer.js",
    "lint:fix": "eslint --fix main.js preload.js renderer.js",
    "format": "prettier --write main.js preload.js renderer.js index.html styles.css",
    "format:check": "prettier --check main.js preload.js renderer.js index.html styles.css",
    "package:mac": "electron-builder build --mac",
    "package:win": "electron-builder build --windows",
    "package:linux": "electron-builder build --linux"
  },
  "keywords": [
    "electron",
    "ftp",
    "file-transfer"
  ],
  "author": "Carlos Mur",
  "license": "ISC",
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^41.10.6",
    "electron-builder": "^26.15.7",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^17.6.0",
    "prettier": "^3.5.3"
  },
  "build": {
    "appId": "com.cmurestudillos.mac-transmit-ftp",
    "productName": "MAC Transmit FTP",
    "directories": {
      "output": "release/"
    },
    "files": [
      "**/*",
      "!docs{,/**/*}",
      "!.github{,/**/*}",
      "!.vscode{,/**/*}",
      "!release{,/**/*}",
      "!README.md",
      "!eslint.config.js",
      "!pnpm-workspace.yaml",
      "!.npmrc",
      "!.prettierrc",
      "!.prettierignore",
      "!.gitattributes"
    ],
    "publish": {
      "provider": "github",
      "owner": "cmurestudillos",
      "repo": "mac-ftp",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "target": "AppImage"
    }
  }
}
